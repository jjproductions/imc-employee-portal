{
  "$schema": "https://developer.microsoft.com/json-schemas/spfx-build/config.2.0.schema.json",
  "version": "2.0",
  "bundles": {
    "custom-links-web-part": {
      "components": [
        {
          "entrypoint": "./lib/webparts/customLinks/CustomLinksWebPart.js",
          "manifest": "./src/webparts/customLinks/CustomLinksWebPart.manifest.json"
        }
      ]
    },
    "imc-hero-web-part": {
      "components": [
        {
          "entrypoint": "./lib/webparts/imcHero/ImcHeroWebPart.js",
          "manifest": "./src/webparts/imcHero/ImcHeroWebPart.manifest.json"
        }
      ]
    }
  },
  "externals": {},
  "localizedResources": {
    "CustomLinksWebPartStrings": "lib/webparts/customLinks/loc/{locale}.js",
    "ImcHeroWebPartStrings": "lib/webparts/imcHero/loc/{locale}.js"
  }
}
